# Run the dashboard on a Pi. Install with:
#   sudo cp rpidash-dashboard.service /etc/systemd/system/ && sudo systemctl enable --now rpidash-dashboard
# Expects a venv at /opt/rpidash-dashboard/venv and the config at /etc/rpidash/dashboard.toml.
# The config can stay root-only (mode 600): systemd hands the service a private copy via
# LoadCredential. Set registry_path = "/var/lib/rpidash/pis.json" in it (the StateDirectory),
# because the credentials directory is read-only.
[Unit]
Description=rpi-dashboard web dashboard
After=network-online.target
Wants=network-online.target

[Service]
DynamicUser=yes
StateDirectory=rpidash
LoadCredential=dashboard.toml:/etc/rpidash/dashboard.toml
ExecStart=/opt/rpidash-dashboard/venv/bin/python -m rpidash_dashboard --config ${CREDENTIALS_DIRECTORY}/dashboard.toml --host 0.0.0.0 --port 8080
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
