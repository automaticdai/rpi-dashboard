# Run the dashboard on a Pi. Install with:
#   sudo cp rpidash-dashboard.service /etc/systemd/system/ && sudo systemctl enable --now rpidash-dashboard
# Expects a venv at /opt/rpidash-dashboard/venv and the config at /etc/rpidash/dashboard.toml.
[Unit]
Description=rpi-dashboard web dashboard
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/opt/rpidash-dashboard/venv/bin/python -m rpidash_dashboard --config /etc/rpidash/dashboard.toml --host 0.0.0.0 --port 8080
Restart=always
RestartSec=5
DynamicUser=yes
StateDirectory=rpidash
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
