[Unit]
Description=rpi-dashboard agent (stats, history, reboot/service actions)
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/opt/rpidash-agent/venv/bin/python -m rpidash_agent --config /etc/rpidash-agent.toml
Restart=always
RestartSec=5
User=root
Nice=10
MemoryMax=80M
# Hardening: the agent only reads system state and asks systemd (over D-Bus) to act.
ProtectSystem=strict
StateDirectory=rpidash-agent
ProtectHome=read-only
PrivateTmp=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
